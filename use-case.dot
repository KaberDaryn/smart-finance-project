digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.3", ranksep="0.65", fontname="Arial", fontsize=18, labelloc=t, label="Smart Finance — Use Case View"];
node [fontname="Arial", fontsize=13, shape=box, style="rounded,filled", color="#177b78", fillcolor="#e0f2ef", fontcolor="#18343e", margin="0.14,0.11"];
edge [fontname="Arial", fontsize=10, color="#476575", fontcolor="#344c5b", arrowsize=0.7];
subgraph cluster_app {
label="Smart Finance system boundary"; color="#a4bebd"; style="rounded";
account [label="Register / sign in / sign out\nFR01", shape=ellipse, fillcolor="#e0f2ef"];
record [label="Enter and save income / expense\nFR03 / FR04", shape=ellipse, fillcolor="#e0f2ef"];
history [label="Search / filter transaction history\nFR05", shape=ellipse, fillcolor="#e0f2ef"];
csv [label="Import CSV\nFR06", shape=ellipse, fillcolor="#e0f2ef"];
receipt [label="Request receipt assistance\nFR07", shape=ellipse, fillcolor="#e0f2ef"];
consent [label="Give external-processing consent\nFR07", shape=ellipse, fillcolor="#e0f2ef"];
extract [label="Extract receipt fields\nFR07 / FR14", shape=ellipse, fillcolor="#e0f2ef"];
review [label="Review / correct proposals\nFR08", shape=ellipse, fillcolor="#e0f2ef"];
validate [label="Validate required fields\nFR03 / FR08", shape=ellipse, fillcolor="#e0f2ef"];
classify [label="Request editable category suggestion\nFR09", shape=ellipse, fillcolor="#e0f2ef"];
insights [label="View summaries / forecast\nFR10 / FR11", shape=ellipse, fillcolor="#e0f2ef"];
budget [label="Set and review monthly budget\nFR12", shape=ellipse, fillcolor="#e0f2ef"];
goal [label="Create / update savings goal\nFR13", shape=ellipse, fillcolor="#e0f2ef"];
}
user [label="Individual user", shape=ellipse, fillcolor="#edf2f7"];
provider [label="External receipt provider", shape=box, fillcolor="#edf2f7"];
user -> account [label="", style=solid];
user -> record [label="", style=solid];
user -> history [label="", style=solid];
user -> csv [label="", style=solid];
user -> receipt [label="", style=solid];
user -> review [label="", style=solid];
user -> classify [label="", style=solid];
user -> insights [label="", style=solid];
user -> budget [label="", style=solid];
user -> goal [label="", style=solid];
receipt -> consent [label="include", style=dashed];
receipt -> extract [label="include", style=dashed];
extract -> provider [label="", style=solid];
record -> validate [label="include", style=dashed];
review -> record [label="Optional next step: explicit Save", style=dashed];
}