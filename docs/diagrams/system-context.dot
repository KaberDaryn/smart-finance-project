digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.3", ranksep="0.65", fontname="Arial", fontsize=18, labelloc=t, label="Smart Finance — System Context"];
node [fontname="Arial", fontsize=13, shape=box, style="rounded,filled", color="#177b78", fillcolor="#e0f2ef", fontcolor="#18343e", margin="0.14,0.11"];
edge [fontname="Arial", fontsize=10, color="#476575", fontcolor="#344c5b", arrowsize=0.7];
user [label="Individual KZT user\nRecords / reviews / plans", shape=ellipse, fillcolor="#edf2f7"];
operator [label="Team / local operator\nDeploys and configures", shape=ellipse, fillcolor="#edf2f7"];
system [label="Smart Finance\nClient + API + financial storage\nRecords, insights, budgets and goals", shape=box, fillcolor="#e0f2ef"];
provider [label="External Gemini provider\nOptional receipt inference", shape=box, fillcolor="#edf2f7"];
user -> system [label="Manual records, plans, consented image / confirmation", style=solid];
system -> user [label="History, summaries, editable proposals / errors", style=solid];
operator -> system [label="Local startup, storage / server-side configuration", style=solid];
system -> provider [label="Image + extraction request after consent", style=solid];
provider -> system [label="Untrusted field proposals / failure", style=solid];
}